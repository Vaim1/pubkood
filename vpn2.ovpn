# Config generated by FreshTomato 2021.3 K26ARM USB AIO-64K, requires OpenVPN 2.4.0 or newer

remote 90.191.218.53 1194
proto tcp-client
dev tun
ncp-ciphers CHACHA20-POLY1305:AES-128-GCM:AES-256-GCM:AES-128-CBC:AES-256-CBC
client
remote-cert-tls server
ca ca.pem
auth-user-pass auth.txt
keepalive 15 60
resolv-retry infinite
nobind
float
verb 3
status status
; log /var/log/openvpn.log

